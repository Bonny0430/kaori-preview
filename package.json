{
    "name":  "kaori-preview",
    "version":  "0.1.0",
    "description":  "Kaori file preview for DSH web: sidebar file tree with text/code/Markdown/image preview",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-connection"
                                          ]
                           }
            },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "dsh.plugin.json",
                  "README.md"
              ],
    "license":  "MIT",
    "scripts":  {
                    "build":  "node build.mjs",
                    "prepack":  "node build.mjs"
                },
    "devDependencies":  {
                            "esbuild":  "^0.25.0"
                        },
    "allowScripts":  {
                         "esbuild@0.25.0":  true
                     }
}
